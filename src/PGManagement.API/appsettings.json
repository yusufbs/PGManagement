{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=PGManagementDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "SecretKey": "SUPER_SECRET_KEY_FOR_DEVELOPMENT_PURPOSES_MIN_32_CHARS_LONG_KEY!",
    "Issuer": "PGManagementAPI",
    "Audience": "PGManagementClient",
    "ExpiryMinutes": 120
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "FeatureManagement": {
    "BillPrintingEnabled": true,
    "OnlineDuesPayment": false,
    "AdvancedReporting": true,
    "TenantSelfPortal": false
  },
  "RateLimiting": {
    "AnonymousRequestsPerMinute": 30,
    "AuthenticatedRequestsPerMinute": 200
  },
  "OpenTelemetry": {
    "ServiceName": "PGManagement.API",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
